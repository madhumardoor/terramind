# TerraMind AI — Environment Configuration
# Copy this file to backend/.env and fill in your values
# Never commit backend/.env to Git

# Application
APP_NAME=TerraMind AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API Server
HOST=0.0.0.0
PORT=8000

# Data paths
RAW_DATA_DIR=../data/raw
PROCESSED_DATA_DIR=../data/processed
METADATA_DIR=../data/metadata

# External APIs (fill these in your .env file)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Logging
LOG_LEVEL=INFO
LOG_DIR=../logs